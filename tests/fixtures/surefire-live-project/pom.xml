<?xml version="1.0" encoding="UTF-8"?>
<!-- A small maven project whose surefire console a declared run relays live:
     three test classes run in a fixed (alphabetical) order, each a few
     seconds long, one with a failure and one with a skip. Each class writes a
     start and an end mark (see live.Marks) so a test can tell which class
     was running when it read the board. Built only in a /tmp copy, offline
     (.mvn/maven.config). -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>live</groupId>
  <artifactId>surefire-live</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <runOrder>alphabetical</runOrder>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
